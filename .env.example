DATABASE_URL="postgresql://postgres:postgres@localhost:5432/inventory_app?schema=public"
# Direct Postgres URL for migrations when DATABASE_URL points at PgBouncer (port 6432)
# DATABASE_DIRECT_URL="postgresql://postgres:postgres@localhost:5432/inventory_app?schema=public"
# Optional read replica for reports/dashboard/lists (streaming replica)
# DATABASE_READ_URL="postgresql://...@127.0.0.1:5433/almadel?schema=public"
# See deploy/postgresql/read-replica.md

# Optional horizontal sharding (SHARD_COUNT=1 default — no change)
# SHARD_COUNT=1
# DATABASE_SHARD_1_URL="postgresql://...@shard1-host:5432/almadel?schema=public"
# DATABASE_SHARD_1_READ_URL="postgresql://...@shard1-replica:5432/almadel?schema=public"
# bash deploy/sharding/migrate-all-shards.sh .env
# Per Node process pool size (total connections ≈ PM2_INSTANCES × DB_POOL_MAX)
# DB_POOL_MAX=10
# DB_POOL_IDLE_MS=30000
# DB_POOL_CONNECT_MS=10000
# PGBOUNCER=true
# PGBOUNCER_HOST=127.0.0.1
# PGBOUNCER_PORT=6432
# PGBOUNCER_DATABASE=almadel
# PGBOUNCER_BACKEND_HOST=127.0.0.1
# PGBOUNCER_BACKEND_PORT=5432
# PGBOUNCER_MAX_CLIENT_CONN=2000
# PGBOUNCER_DEFAULT_POOL_SIZE=25
# PGBOUNCER_MIN_POOL_SIZE=5
# PGBOUNCER_RESERVE_POOL_SIZE=5
# Apply to systemd PgBouncer: sudo bash deploy/pgbouncer/install-from-env.sh .env
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
API_PORT="4000"
API_HOST="0.0.0.0"
FRONTEND_URL="http://localhost:3000"
# Comma-separated browser origins allowed for CORS + Socket.IO (no wildcards)
# CORS_ORIGINS="https://your-app.vercel.app,https://app.example.com"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-password"
ADMIN_NAME="Admin"
RESEND_API_KEY=""
EMAIL_FROM="Almadel <no-reply@your-domain.com>"
# Auth emails (magic link, forgot password): smtp (default) or resend after domain verified at resend.com/domains
# AUTH_EMAIL_PROVIDER=resend
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Almadel <no-reply@your-domain.com>"
# Web app reset page (must match a URL your Next.js app serves). Omit to use FRONTEND_URL/reset-password.
# PASSWORD_RESET_URL="http://localhost:3000/reset-password"
# Mobile deep link example: PASSWORD_RESET_URL="myapp://reset-password"

# Password hashing cost (bcrypt rounds). Higher = slower sign-up under concurrency.
# PASSWORD_HASH_ROUNDS=10

# Auth rate limits (15 min window unless AUTH_RATE_LIMIT_WINDOW_MS is set)
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_SIGNIN_MAX_PER_IP=30
# AUTH_SIGNIN_MAX_PER_EMAIL=10
# AUTH_SIGNUP_MAX_PER_IP=20
# AUTH_SIGNUP_MAX_PER_EMAIL=5
# AUTH_STAFF_CREATE_MAX_PER_IP=30
# AUTH_FORGOT_PASSWORD_MAX_PER_IP=15
# AUTH_FORGOT_PASSWORD_MAX_PER_EMAIL=5
# AUTH_RESET_PASSWORD_MAX_PER_IP=20
# AUTH_RESET_PASSWORD_MAX_PER_TOKEN=5
# AUTH_RATE_LIMIT_DISABLED=true

# List / import caps
# PRODUCTS_LIST_DEFAULT_LIMIT=50
# PRODUCTS_LIST_MAX_LIMIT=250
# PRODUCTS_IMPORT_MAX_ROWS=2000
# PRODUCTS_IMPORT_CHUNK_SIZE=75

# File logging (daily files under ./logs — gitignored)
# LOG_DIR=logs
# LOG_TO_CONSOLE=true
# LOG_REQUESTS=true

# Redis complements PostgreSQL (Socket.IO + soft dashboard/report cache).
# Postgres remains the source of truth for sales/stock/payments/ledger.
REDIS_URL=redis://127.0.0.1:6379
ENABLE_REDIS=true
REDIS_KEY_PREFIX=almadel:
# REDIS_DB=2
# REDIS_CACHE_TTL_DASHBOARD_MS=20000
# REDIS_CACHE_TTL_REPORTS_MS=45000

# Horizontal scale: shared auth rate limits across PM2 cluster (default on when Redis enabled)
# AUTH_RATE_LIMIT_REDIS=false

# PM2 cluster (ecosystem.config.js)
# PM2_INSTANCES=2
# PM2_MAX_MEMORY=750M

# Optional Elasticsearch product search (Postgres fallback when unset)
# ELASTICSEARCH_URL=https://localhost:9200
# ELASTICSEARCH_API_KEY=
# ELASTICSEARCH_PRODUCTS_INDEX=almadel-products
# ELASTICSEARCH_TIMEOUT_MS=3000
