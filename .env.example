DATABASE_URL="postgresql://postgres:postgres@localhost:5432/inventory_app?schema=public"
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
API_PORT="4000"
API_HOST="0.0.0.0"
FRONTEND_URL="http://localhost:3000"
# Comma-separated browser origins allowed for CORS + Socket.IO (no wildcards)
# CORS_ORIGINS="https://your-app.vercel.app,https://app.example.com"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-password"
ADMIN_NAME="Admin"
RESEND_API_KEY=""
EMAIL_FROM="Almadel <no-reply@your-domain.com>"
# Web app reset page (must match a URL your Next.js app serves). Omit to use FRONTEND_URL/reset-password.
# PASSWORD_RESET_URL="http://localhost:3000/reset-password"
# Mobile deep link example: PASSWORD_RESET_URL="myapp://reset-password"

# Auth rate limits (15 min window unless AUTH_RATE_LIMIT_WINDOW_MS is set)
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_SIGNIN_MAX_PER_IP=30
# AUTH_SIGNIN_MAX_PER_EMAIL=10
# AUTH_FORGOT_PASSWORD_MAX_PER_IP=15
# AUTH_FORGOT_PASSWORD_MAX_PER_EMAIL=5
# AUTH_RESET_PASSWORD_MAX_PER_IP=20
# AUTH_RESET_PASSWORD_MAX_PER_TOKEN=5
# AUTH_RATE_LIMIT_DISABLED=true

# Optional: enable Socket.IO room broadcasts across multiple API instances
# REDIS_URL=redis://localhost:6379
