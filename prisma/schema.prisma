generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  staff
  accountant
}

model User {
  id                  Int                  @id @default(autoincrement())
  email               String               @unique
  fullName            String?
  passwordHash        String
  authVersion         Int                  @default(0)
  role                UserRole             @default(staff)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  passwordResetTokens PasswordResetToken[]
  products            Product[]            @relation("ProductCreator")
  sales               Sale[]
  stockLogs           StockLog[]
  ownedBusinesses     Business[]           @relation("BusinessOwner")
  businessMemberships BusinessMember[]
  createdExpenses Expense[] @relation("ExpenseCreator")
  createdLedgerTransactions LedgerTransaction[] @relation("LedgerCreator")
  createdDailyClosings DailyClosing[] @relation("ClosingCreator")
  createdPayments Payment[] @relation("PaymentCreator")
}

model Business {
  id                  Int              @id @default(autoincrement())
  name                String
  businessType        String           @default("Mobile Shop")
  businessCategory    String?
  mobileNumber        String
  whatsappNumber      String?
  email               String?
  address             String?
  city                String?
  area                String?
  province            String?
  accountingStartDate DateTime?
  openingCashBalance  Float            @default(0)
  openingBankBalance  Float            @default(0)
  bankAccounts        Json?            @default("[]")
  hasCustomerUdhaar   Boolean          @default(false)
  customerReceivable  Float            @default(0)
  hasSupplierUdhaar   Boolean          @default(false)
  supplierPayable     Float            @default(0)
  manageStock         Boolean          @default(true)
  allowDiscounts      Boolean          @default(true)
  currentStockValue   Float            @default(0)
  taxRegistered       String?          @default("no")
  ntn                 String?
  strn                String?
  taxBusinessName     String?
  logoUrl             String?
  workspaceMode       String           @default("pos")
  subscriptionStatus  String           @default("trialing")
  trialEndsAt         DateTime?
  stripeCustomerId    String?
  stripeSubscriptionId String?
  stripePriceId       String?
  currentPeriodEnd    DateTime?
  cancelAtPeriodEnd   Boolean          @default(false)
  ownerId             Int
  owner               User             @relation("BusinessOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  members             BusinessMember[]
  products            Product[]
  sales               Sale[]
  customers           Customer[]
  suppliers           Supplier[]
  stockLogs           StockLog[]
  activityLogs        ActivityLog[]
  accounts            Account[]
  ledgerTransactions  LedgerTransaction[]
  expenses            Expense[]
  dailyClosings       DailyClosing[]
  payments            Payment[]
  branches            Branch[]

  @@index([ownerId])
  @@map("businesses")
}

model BusinessMember {
  id         Int      @id @default(autoincrement())
  businessId Int
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       String   @default("owner")
  createdAt  DateTime @default(now())

  @@unique([businessId, userId])
  @@index([userId])
  @@map("business_members")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Product {
  id                Int        @id @default(autoincrement())
  businessId        Int?
  business          Business?  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  barcode           String
  sku               String?
  qrCode            String?
  name              String
  category          String?
  imageUrl          String?
  costPrice         Float      @default(0)
  price             Float
  sellingPrice      Float      @default(0)
  stock             Int        @default(0)
  lowStockThreshold Int        @default(5)
  discountType      String     @default("none")
  discountValue     Float      @default(0)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  createdByUserId   Int?
  createdByUser     User?      @relation("ProductCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  saleItems         SaleItem[]
  stockLogs         StockLog[]

  @@unique([businessId, barcode])
  @@index([businessId])
  @@index([businessId, name])
  @@index([businessId, category])
  @@index([name])
  @@index([category])
  @@map("products")
}

model SaleItem {
  id             Int     @id @default(autoincrement())
  saleId         Int
  productId      Int
  barcode        String
  name           String
  price          Float
  quantity       Int
  discountType   String  @default("none")
  discountValue  Float   @default(0)
  discountAmount Float   @default(0)
  total          Float
  sale           Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product        Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("sale_items")
}

model StockLog {
  id            Int       @id @default(autoincrement())
  businessId    Int?
  business      Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productId     Int
  barcode       String
  quantity      Int
  previousStock Int
  newStock      Int
  note          String?
  createdAt     DateTime  @default(now())
  userId        Int?
  branchId      Int?
  branch        Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  product       Product   @relation(fields: [productId], references: [id])
  user          User?     @relation(fields: [userId], references: [id])

  @@index([businessId])
  @@index([branchId])
  @@map("stock_logs")
}

model Customer {
  id           Int       @id @default(autoincrement())
  businessId   Int?
  business     Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String
  mobile       String
  passwordHash String?
  email        String?
  totalSpent     Float     @default(0)
  visitCount     Int       @default(0)
  openingBalance Float     @default(0)
  currentBalance Float     @default(0)
  lastVisit      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  payments       Payment[]
  sales          Sale[]

  @@unique([businessId, mobile])
  @@index([businessId])
  @@map("customers")
}

model Supplier {
  id             Int       @id @default(autoincrement())
  businessId     Int?
  business       Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name           String
  mobile         String?
  email          String?
  openingBalance Float     @default(0)
  currentBalance Float     @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  payments       Payment[]

  @@index([businessId])
  @@map("suppliers")
}

model Sale {
  id             Int        @id @default(autoincrement())
  businessId     Int?
  business       Business?  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoiceNumber  String     @unique
  subtotal       Float
  discountType   String     @default("none")
  discountValue  Float      @default(0)
  discountAmount Float      @default(0)
  totalAmount    Float
  totalItems     Int
  paymentMethod  String     @default("cash")
  customerName   String?
  customerMobile String?
  createdAt      DateTime   @default(now())
  userId         Int?
  user           User?      @relation(fields: [userId], references: [id])
  customerId     Int?
  customer       Customer?  @relation(fields: [customerId], references: [id])
  branchId       Int?
  branch         Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  items          SaleItem[]
  payments       Payment[]

  @@index([businessId])
  @@index([branchId])
  @@map("sales")
}

model ActivityLog {
  id         Int       @id @default(autoincrement())
  businessId Int?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  timestamp  DateTime  @default(now())
  
  // User info
  userId     Int?      @map("user_id")
  userName   String    @map("user_name")
  userEmail  String    @map("user_email")
  userRole   String    @default("staff") @map("user_role")
  
  // Event details
  action     String
  category   String
  details    String    @db.Text
  target     String?
  meta       Json?     @default("{}")

  @@index([businessId])
  @@index([timestamp(sort: Desc)])
  @@index([category])
  @@index([userEmail])
  @@map("activity_logs")
}

model Account {
  id Int @id @default(autoincrement())
  businessId Int
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name String
  type String @default("cash")
  openingBalance Float @default(0)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  transactions LedgerTransaction[]
  payments Payment[]
  expenses Expense[]
  @@unique([businessId, name])
  @@index([businessId, type])
  @@map("accounts")
}

model LedgerTransaction {
  id Int @id @default(autoincrement())
  businessId Int
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  accountId Int
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  type String
  direction String
  amount Float
  reference String?
  note String?
  occurredAt DateTime @default(now())
  createdAt DateTime @default(now())
  createdById Int?
  createdBy User? @relation("LedgerCreator", fields: [createdById], references: [id], onDelete: SetNull)
  paymentId Int?
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  @@index([businessId, occurredAt])
  @@index([accountId, occurredAt])
  @@map("ledger_transactions")
}

model Expense {
  id Int @id @default(autoincrement())
  businessId Int
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  accountId Int
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  amount Float
  category String
  description String?
  occurredAt DateTime @default(now())
  createdById Int?
  createdBy User? @relation("ExpenseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([businessId, occurredAt])
  @@map("expenses")
}

model Payment {
  id Int @id @default(autoincrement())
  businessId Int
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  accountId Int
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  customerId Int?
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplierId Int?
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  saleId Int?
  sale Sale? @relation(fields: [saleId], references: [id], onDelete: SetNull)
  amount Float
  type String
  method String
  reference String?
  status String @default("completed")
  occurredAt DateTime @default(now())
  createdById Int?
  createdBy User? @relation("PaymentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  ledgerTransactions LedgerTransaction[]
  @@index([businessId, occurredAt])
  @@map("payments")
}

model DailyClosing {
  id Int @id @default(autoincrement())
  businessId Int
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessDate DateTime @db.Date
  status String @default("open")
  openingCash Float @default(0)
  expectedCash Float @default(0)
  countedCash Float?
  difference Float?
  note String?
  closedById Int?
  closedBy User? @relation("ClosingCreator", fields: [closedById], references: [id], onDelete: SetNull)
  closedAt DateTime?
  reopenedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([businessId, businessDate])
  @@index([businessId, status])
  @@map("daily_closings")
}

model Branch {
  id         Int        @id @default(autoincrement())
  businessId Int
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String     @default("Main Branch")
  code       String?
  address    String?
  city       String?
  phone      String?
  isMain     Boolean    @default(true)
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  sales      Sale[]
  stockLogs  StockLog[]

  @@unique([businessId, name])
  @@index([businessId])
  @@map("branches")
}

