generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  staff
  accountant
  pending
  owner
}

model User {
  id                  Int                  @id @default(autoincrement())
  email               String               @unique
  fullName            String?
  passwordHash        String
  authVersion         Int                  @default(0)
  role                UserRole             @default(staff)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  passwordResetTokens PasswordResetToken[]
  magicLinkTokens     MagicLinkToken[]
  passkeyCredentials  PasskeyCredential[]
  products            Product[]            @relation("ProductCreator")
  sales               Sale[]
  refunds             Refund[]
  stockLogs           StockLog[]
  ownedBusinesses     Business[]           @relation("BusinessOwner")
  businessMemberships BusinessMember[]
  createdExpenses Expense[] @relation("ExpenseCreator")
  createdLedgerTransactions LedgerTransaction[] @relation("LedgerCreator")
  createdDailyClosings DailyClosing[] @relation("ClosingCreator")
  createdPayments Payment[] @relation("PaymentCreator")
  businessOnboardingDraft BusinessOnboardingDraft?
}

model BusinessOnboardingDraft {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payload       Json
  workspaceMode String   @default("pos")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("business_onboarding_drafts")
}

model Business {
  id                  Int              @id @default(autoincrement())
  name                String
  businessType        String           @default("Mobile Shop")
  businessCategory    String?
  mobileNumber        String
  whatsappNumber      String?
  email               String?
  address             String?
  city                String?
  area                String?
  province            String?
  accountingStartDate DateTime?
  openingCashBalance  Decimal          @default(0) @db.Decimal(14, 2)
  openingBankBalance  Decimal          @default(0) @db.Decimal(14, 2)
  bankAccounts        Json?            @default("[]")
  hasCustomerUdhaar   Boolean          @default(false)
  customerReceivable  Decimal          @default(0) @db.Decimal(14, 2)
  hasSupplierUdhaar   Boolean          @default(false)
  supplierPayable     Decimal          @default(0) @db.Decimal(14, 2)
  manageStock         Boolean          @default(true)
  allowDiscounts      Boolean          @default(true)
  currentStockValue   Decimal          @default(0) @db.Decimal(14, 2)
  taxRegistered       String?          @default("no")
  ntn                 String?
  strn                String?
  taxBusinessName     String?
  logoUrl             String?
  workspaceMode       String           @default("pos")
  subscriptionStatus  String           @default("trialing")
  trialEndsAt         DateTime?
  stripeCustomerId    String?
  stripeSubscriptionId String?
  stripePriceId       String?
  currentPeriodEnd    DateTime?
  cancelAtPeriodEnd   Boolean          @default(false)
  ownerId             Int              @unique
  owner               User             @relation("BusinessOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  members             BusinessMember[]
  products            Product[]
  sales               Sale[]
  customers           Customer[]
  suppliers           Supplier[]
  stockLogs           StockLog[]
  activityLogs        ActivityLog[]
  accounts            Account[]
  ledgerTransactions  LedgerTransaction[]
  expenses            Expense[]
  dailyClosings       DailyClosing[]
  payments            Payment[]
  refunds             Refund[]
  branches            Branch[]
  categories          Category[]

  @@map("businesses")
}

model BusinessMember {
  id         Int      @id @default(autoincrement())
  businessId Int
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     Int      @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       String   @default("owner")
  createdAt  DateTime @default(now())

  @@unique([businessId, userId])
  @@index([businessId])
  @@map("business_members")
}

model Category {
  id          Int      @id @default(autoincrement())
  businessId  Int
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([businessId, name])
  @@index([businessId])
  @@map("categories")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model MagicLinkToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("magic_link_tokens")
}

model PasskeyCredential {
  id           Int       @id @default(autoincrement())
  userId       Int
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String    @unique
  publicKey    Bytes
  counter      BigInt    @default(0)
  deviceType   String?
  backedUp     Boolean   @default(false)
  transports   String[]  @default([])
  aaguid       String?
  friendlyName String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
  @@map("passkey_credentials")
}

model Product {
  id                Int        @id @default(autoincrement())
  businessId        Int
  business          Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  barcode           String
  sku               String?
  qrCode            String?
  name              String
  category          String?
  imageUrl          String?
  costPrice         Decimal    @default(0) @db.Decimal(14, 2)
  price             Decimal    @db.Decimal(14, 2)
  sellingPrice      Decimal    @default(0) @db.Decimal(14, 2)
  stock             Int        @default(0)
  lowStockThreshold Int        @default(5)
  discountType      String     @default("none")
  discountValue     Decimal    @default(0) @db.Decimal(14, 2)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  createdByUserId   Int?
  createdByUser     User?      @relation("ProductCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  saleItems         SaleItem[]
  refundItems       RefundItem[]
  stockLogs         StockLog[]

  @@unique([businessId, barcode])
  @@index([businessId])
  @@index([businessId, name])
  @@index([businessId, category])
  @@index([businessId, createdAt(sort: Desc)])
  @@index([name])
  @@index([category])
  @@map("products")
}

model SaleItem {
  id             Int     @id @default(autoincrement())
  saleId         Int
  productId      Int
  barcode        String
  name           String
  price          Decimal @db.Decimal(14, 2)
  quantity       Int
  discountType   String  @default("none")
  discountValue  Decimal @default(0) @db.Decimal(14, 2)
  discountAmount Decimal @default(0) @db.Decimal(14, 2)
  total              Decimal      @db.Decimal(14, 2)
  refundedQuantity   Int          @default(0)
  sale               Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product            Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  refundItems        RefundItem[]

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model StockLog {
  id            Int       @id @default(autoincrement())
  businessId    Int
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productId     Int
  barcode       String
  quantity      Int
  previousStock Int
  newStock      Int
  note          String?
  createdAt     DateTime  @default(now())
  userId        Int?
  branchId      Int?
  branch        Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  product       Product   @relation(fields: [productId], references: [id])
  user          User?     @relation(fields: [userId], references: [id])

  @@index([businessId])
  @@index([businessId, createdAt(sort: Desc)])
  @@index([branchId])
  @@index([productId])
  @@map("stock_logs")
}

model Customer {
  id           Int       @id @default(autoincrement())
  businessId   Int
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String
  mobile       String
  passwordHash String?
  email        String?
  totalSpent     Decimal   @default(0) @db.Decimal(14, 2)
  visitCount     Int       @default(0)
  openingBalance Decimal   @default(0) @db.Decimal(14, 2)
  currentBalance Decimal   @default(0) @db.Decimal(14, 2)
  lastVisit      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  payments       Payment[]
  sales          Sale[]

  @@unique([businessId, mobile])
  @@index([businessId])
  @@index([businessId, name])
  @@map("customers")
}

model Supplier {
  id             Int       @id @default(autoincrement())
  businessId     Int
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name           String
  mobile         String?
  email          String?
  openingBalance Decimal   @default(0) @db.Decimal(14, 2)
  currentBalance Decimal   @default(0) @db.Decimal(14, 2)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  payments       Payment[]

  @@index([businessId])
  @@map("suppliers")
}

model Sale {
  id             Int        @id @default(autoincrement())
  businessId     Int
  business       Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoiceNumber  String
  subtotal       Decimal    @db.Decimal(14, 2)
  discountType   String     @default("none")
  discountValue  Decimal    @default(0) @db.Decimal(14, 2)
  discountAmount Decimal    @default(0) @db.Decimal(14, 2)
  totalAmount    Decimal    @db.Decimal(14, 2)
  refundedAmount Decimal    @default(0) @db.Decimal(14, 2)
  totalItems     Int
  paymentMethod  String     @default("cash")
  customerName   String?
  customerMobile String?
  createdAt      DateTime   @default(now())
  userId         Int?
  user           User?      @relation(fields: [userId], references: [id])
  customerId     Int?
  customer       Customer?  @relation(fields: [customerId], references: [id])
  branchId       Int?
  branch         Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  items          SaleItem[]
  payments       Payment[]
  refunds        Refund[]

  @@unique([businessId, invoiceNumber])
  @@index([businessId])
  @@index([businessId, createdAt(sort: Desc)])
  @@index([branchId])
  @@map("sales")
}

model Refund {
  id             Int          @id @default(autoincrement())
  businessId     Int
  business       Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  saleId         Int
  sale           Sale         @relation(fields: [saleId], references: [id], onDelete: Restrict)
  refundNumber   String
  totalAmount    Decimal      @db.Decimal(14, 2)
  reason         String?
  paymentMethod  String       @default("cash")
  createdAt      DateTime     @default(now())
  userId         Int?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  branchId       Int?
  branch         Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  items          RefundItem[]

  @@unique([businessId, refundNumber])
  @@index([businessId, createdAt(sort: Desc)])
  @@index([saleId])
  @@map("refunds")
}

model RefundItem {
  id         Int      @id @default(autoincrement())
  refundId   Int
  refund     Refund   @relation(fields: [refundId], references: [id], onDelete: Cascade)
  saleItemId Int
  saleItem   SaleItem @relation(fields: [saleItemId], references: [id], onDelete: Restrict)
  productId  Int
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  barcode    String
  name       String
  quantity   Int
  unitAmount Decimal  @db.Decimal(14, 2)
  total      Decimal  @db.Decimal(14, 2)

  @@index([refundId])
  @@index([saleItemId])
  @@map("refund_items")
}

model ActivityLog {
  id         Int       @id @default(autoincrement())
  businessId Int
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  timestamp  DateTime  @default(now())
  
  // User info
  userId     Int?      @map("user_id")
  userName   String    @map("user_name")
  userEmail  String    @map("user_email")
  userRole   String    @default("staff") @map("user_role")
  
  // Event details
  action     String
  category   String
  details    String    @db.Text
  target     String?
  meta       Json?     @default("{}")

  @@index([businessId])
  @@index([businessId, timestamp(sort: Desc)])
  @@index([timestamp(sort: Desc)])
  @@index([category])
  @@index([userEmail])
  @@map("activity_logs")
}

model Account {
  id Int @id @default(autoincrement())
  businessId Int
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name String
  type String @default("cash")
  openingBalance Decimal @default(0) @db.Decimal(14, 2)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  transactions LedgerTransaction[]
  payments Payment[]
  expenses Expense[]
  @@unique([businessId, name])
  @@index([businessId, type])
  @@map("accounts")
}

model LedgerTransaction {
  id Int @id @default(autoincrement())
  businessId Int
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  accountId Int
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  type String
  direction String
  amount Decimal @db.Decimal(14, 2)
  reference String?
  note String?
  occurredAt DateTime @default(now())
  createdAt DateTime @default(now())
  createdById Int?
  createdBy User? @relation("LedgerCreator", fields: [createdById], references: [id], onDelete: SetNull)
  paymentId Int? @unique
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  expenseId Int? @unique
  expense Expense? @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  @@index([businessId, occurredAt])
  @@index([accountId, occurredAt])
  @@map("ledger_transactions")
}

model Expense {
  id Int @id @default(autoincrement())
  businessId Int
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  accountId Int
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  amount Decimal @db.Decimal(14, 2)
  category String
  description String?
  occurredAt DateTime @default(now())
  createdById Int?
  createdBy User? @relation("ExpenseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ledgerTransaction LedgerTransaction?
  @@index([businessId, occurredAt])
  @@map("expenses")
}

model Payment {
  id Int @id @default(autoincrement())
  businessId Int
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  accountId Int
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  customerId Int?
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplierId Int?
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  saleId Int?
  sale Sale? @relation(fields: [saleId], references: [id], onDelete: SetNull)
  amount Decimal @db.Decimal(14, 2)
  type String
  method String
  reference String?
  status String @default("completed")
  occurredAt DateTime @default(now())
  createdById Int?
  createdBy User? @relation("PaymentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  ledgerTransactions LedgerTransaction[]
  @@index([businessId, occurredAt])
  @@index([customerId])
  @@index([supplierId])
  @@index([saleId])
  @@map("payments")
}

model DailyClosing {
  id Int @id @default(autoincrement())
  businessId Int
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessDate DateTime @db.Date
  status String @default("open")
  openingCash Decimal @default(0) @db.Decimal(14, 2)
  expectedCash Decimal @default(0) @db.Decimal(14, 2)
  countedCash Decimal? @db.Decimal(14, 2)
  difference Decimal? @db.Decimal(14, 2)
  note String?
  closedById Int?
  closedBy User? @relation("ClosingCreator", fields: [closedById], references: [id], onDelete: SetNull)
  closedAt DateTime?
  reopenedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([businessId, businessDate])
  @@index([businessId, status])
  @@map("daily_closings")
}

model Branch {
  id         Int        @id @default(autoincrement())
  businessId Int
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String     @default("Main Branch")
  code       String?
  address    String?
  city       String?
  phone      String?
  isMain     Boolean    @default(true)
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  sales      Sale[]
  refunds    Refund[]
  stockLogs  StockLog[]

  @@unique([businessId, name])
  @@index([businessId])
  @@map("branches")
}
